    "primary_references": [
      {
        "url": "https://github.com/godotengine/godot-docs/blob/4.7/tutorials/performance/pipeline_compilations.rst",
        "supports": "Draw and surface compilation during gameplay can cause first-use stalls. Hidden instancing can prepare dynamic effects; shader baking addresses initial shader translation rather than all pipeline stalls."
      },
      {
        "url": "https://github.com/godotengine/godot/blob/4.7.2-stable/drivers/metal/rendering_device_driver_metal.cpp#L1558",
        "supports": "Godot Metal pipeline_cache_create returns false in this pinned release; the user shader files are not a persistent Godot Metal pipeline archive."
      },
      {
        "url": "https://github.com/godotengine/godot/blob/4.7.2-stable/drivers/metal/metal_objects_shared.cpp#L747",
        "supports": "The immediate Metal library path uses asynchronous compilation and waits for completion when the library is requested."
      }
    ],
    "recommended_next_action": "Retain the uncured first-use limitation and the complete evidence. Any later targeted prewarm change should identify and exercise actual effect/material/mesh variants, then validate first-use pipeline counts and wall-frame tails with a fresh isolated app cache. Avoid threshold relaxation or timing-only warm-up masking."
