#!/usr/bin/env python
from pathlib import Path

env = SConscript('vendor/godot-cpp/SConstruct')
env.Append(CPPPATH=['src', 'vendor/lua/src'])
# Core + minimal base/math library only. Never link OS, IO, package, debug or string libraries.
excluded = {'lua.c', 'luac.c', 'linit.c', 'liolib.c', 'loslib.c', 'loadlib.c',
            'ldblib.c', 'lstrlib.c', 'ltablib.c', 'lutf8lib.c', 'lcorolib.c'}
lua_sources = [str(path) for path in Path('vendor/lua/src').glob('*.c') if path.name not in excluded]
if env['platform'] == 'macos':
    env['SHLIBSUFFIX'] = '.dylib'
    env.Append(LINKFLAGS=['-framework', 'Security', '-framework', 'CoreFoundation', '-framework', 'LocalAuthentication'])
if env['platform'] == 'windows':
    env.Append(LIBS=['Advapi32'])
sources = Glob('src/*.cpp') + Glob('src/*.c') + lua_sources
if env['platform'] == 'macos':
    sources += Glob('src/*.mm')
extension = {'macos': '.dylib', 'linux': '.so', 'windows': '.dll'}[env['platform']]
library = env.SharedLibrary('../../source/native/bin/rts_lua.' + env['platform'] + '.' + env['arch'] + extension, source=sources)
registration = env.Command('../../source/native/rts_lua.gdextension', 'extension.template',
                           Copy('$TARGET', '$SOURCE'))
# Windows SharedLibrary returns DLL and import-library nodes; do not use a
# positional index into that expanded source list to select the manifest.
env.Depends(registration, library)
Default(library, registration)
